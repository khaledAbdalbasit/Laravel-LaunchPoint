# ============================================
# Laravel Package - .gitignore
# ============================================

# --- Composer ---
/vendor/
composer.lock

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Laravel App Files (not part of the package) ---
/app/
/bootstrap/
/database/
/storage/
/resources/
/routes/
/public/
/packages/

# --- Testing ---
.phpunit.result.cache
/.phpunit.cache/
coverage/

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
