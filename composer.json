{
    "name": "khaledabdalbasit/launchpoint",
    "description": "Laravel Starter Kit for API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "fisal/laravel-otp": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaunchPoint\\": "src/"
        }
    },
    "scripts": {
        "post-package-install": [
            "LaunchPoint\\Traits\\CanDisplayLogo::displayWelcomeMessage"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaunchPoint\\Providers\\LaunchPointServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
