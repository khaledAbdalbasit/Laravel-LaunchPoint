<?php

namespace {{namespace}};

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Http\Request;
use Illuminate\Support\Str;

/**
 * Class {{class}}
 *
 * Eloquent Query Filter generated by LaunchPoint.
 */
class {{class}}
{
    /**
     * The incoming filters or request parameters.
     *
     * @var array
     */
    protected array $filters;

    /**
     * {{class}} constructor.
     *
     * @param Request|array $filters
     */
    public function __construct(Request|array $filters = [])
    {
        $this->filters = $filters instanceof Request ? $filters->all() : $filters;
    }

    /**
     * Apply filter criteria to the query builder.
     *
     * @param Builder $query
     * @return Builder
     */
    public function apply(Builder $query): Builder
    {
        foreach ($this->filters as $filter => $value) {
            if ($value === null || $value === '') {
                continue;
            }

            $method = Str::camel($filter);

            if (method_exists($this, $method)) {
                $this->$method($query, $value);
            }
        }

        return $query;
    }

    /**
     * Example: Filter by search keyword.
     *
     * @param Builder $query
     * @param mixed $value
     * @return Builder
     */
    public function search(Builder $query, mixed $value): Builder
    {
        return $query->where(function (Builder $q) use ($value) {
            $q->where('name', 'like', "%{$value}%");
        });
    }

    /**
     * Example: Filter by status.
     *
     * @param Builder $query
     * @param mixed $value
     * @return Builder
     */
    public function status(Builder $query, mixed $value): Builder
    {
        return $query->where('status', $value);
    }
}
